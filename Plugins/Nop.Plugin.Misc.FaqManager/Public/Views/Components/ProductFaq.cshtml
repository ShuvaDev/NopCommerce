@model Nop.Plugin.Misc.FaqManager.Public.Models.ProductFaqModel

@if(Model.Items.Any()) {
    <link href="~/Plugins/Misc.FaqManager/Content/styles.css" rel="stylesheet">

    <div class="faq-container">
        <h2 class="faq-title">
            Frequently Asked Questions

            @if (Model.ShowFaqCount)
            {
                <span class="faq-count">(@Model.FaqCount)</span>
            }
        </h2>

        @foreach (var item in Model.Items)
        {
            <div class="faq-item">
                <button class="faq-question">
                    @Html.Raw(item.Question)
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <p>@Html.Raw(item.Answer)</p>
                </div>
            </div>
        }
    </div>

    <script type="application/ld+json">
        @Html.Raw(Model.JsonLd)
    </script>
    <script src="~/Plugins/Misc.FaqManager/Content/scripts.js"></script>
}