@model FaqGroupModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        @(await Html.LocalizedEditorAsync<FaqGroupModel, FaqGroupLocalizedModel>("faqgroup-name-localized",
                            @<div>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="@Model.Locales[item].Name" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="@Model.Locales[item].Name" />
                                        <span asp-validation-for="@Model.Locales[item].Name"></span>
                                    </div>
                                </div>
                                <input type="hidden" asp-for="@Model.Locales[item].LanguageId" />
                            </div>
                            ,
                            @<div>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="Name" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="Name" asp-required="true" />
                                        <span asp-validation-for="Name"></span>
                                    </div>
                                </div>
                            </div>
                        ))

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="ProductId" />
                            </div>
                            <div class="col-md-9">
                                <input type="hidden" asp-for="ProductId" />
                                <span id="product-name">@Model.ProductName</span>
                                <button type="submit" onclick="javascript:OpenWindow('@(Url.Action("ProductSearchPopup", "FaqGroup", new { productIdInput = Html.IdFor(model => model.ProductId), productNameInput = "product-name", btnId = "btnRefreshProduct" }))', 800, 850, true); return false;" class="btn btn-primary">
                                    @T("Admin.Catalog.Products.Fields.Product.Choose")
                                </button>
                                <button type="submit" id="product-name-remove" class="btn btn-danger">
                                    @T("Admin.Catalog.Products.Fields.Product.Remove")
                                </button>
                                <button type="submit" id="btnRefreshProduct" style="display: none"></button>
                                <span asp-validation-for="ProductId"></span>
                            </div>
                        </div>

                        <script>
                            $(function () {
                                toggleRemoveButton();
                            });

                            function toggleRemoveButton() {
                                if ($('#@Html.IdFor(model => model.ProductId)').val() > 0) {
                                    $('#product-name-remove').showElement();
                                } else {
                                    $('#product-name-remove').hideElement();
                                }
                            }

                            $('#product-name-remove').click(function () {
                                $('#product-name').text('');
                                $('#@Html.IdFor(model => model.ProductId)').val(0);
                                toggleRemoveButton();
                                return false;
                            });

                            $('#btnRefreshProduct').click(function () {
                                toggleRemoveButton();
                                return false;
                            });
                        </script>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Published" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Published" />
                                <span asp-validation-for="Published"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DisplayOrder" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DisplayOrder" />
                                <span asp-validation-for="DisplayOrder"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>