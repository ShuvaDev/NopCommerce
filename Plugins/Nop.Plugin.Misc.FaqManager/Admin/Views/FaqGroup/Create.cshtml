@model FaqGroupModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.FaqManager.Groups.AddNew").Text;
    NopHtml.SetActiveMenuItemSystemName(Nop.Plugin.Misc.FaqManager.FaqManagerDefaults.FaqGroupMenuSystemName);
}

<form asp-controller="FaqGroup" asp-action="Create" method="post" id="faqgroup-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.FaqManager.Groups.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Plugins.Misc.FaqManager.Groups.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.FaqManager/Admin/Views/FaqGroup/_CreateOrUpdate.cshtml", Model)
</form>